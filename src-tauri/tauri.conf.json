{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Relay",
  "version": "0.2.0-beta.1",
  "identifier": "com.codexrelay.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Relay",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "decorations": true,
        "backgroundColor": "#F4F6F9"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "Apple Development: Maynor Zhong (8A42TPPVGX)"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCMEVEM0VDQTE3MzkyNwpSV1FuT1JmS1B1MndDaERpTE5uQ091eVlKYkgxcjZRTkIrbXVoZDBwaHBJRmFwaU5CdEVuaFdhbQo=",
      "endpoints": [
        "https://github.com/RayZh0ng/codex-reply/releases/download/updater/stable.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
