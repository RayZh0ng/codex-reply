{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Relay",
  "version": "0.1.0",
  "identifier": "com.codexrelay.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Relay",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "decorations": true,
        "backgroundColor": "#F4F6F9"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "Apple Development: Maynor Zhong (8A42TPPVGX)"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
